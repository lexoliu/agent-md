{
  "name": "agent-md",
  "version": "0.1.0",
  "description": "Install skill-style instruction packages into AGENTS.md/CLAUDE.md via a coding agent, with diff review",
  "type": "module",
  "bin": {
    "agent-md": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
