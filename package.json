    "prepublishOnly": "npm run build"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@clack/prompts": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
